#api call for listing employee
###
GET http://127.0.0.1:8000/employees/
Accept: application/json

#api call for creating employee
###
POST http://127.0.0.1:8000/employees/
Content-Type: application/json

{
    "name":"hari",
    "email":"hari@gmail.com",
    "phone":"4567890",
    "salary":"56000",
    "department":"hr",
    "location":"kakkanad"
}


#api call for retrieving a single object
###
GET http://127.0.0.1:8000/employees/1/
Accept: application/json


#api call for updating Employee
###
PUT http://127.0.0.1:8000/employees/1/
Content-Type: application/json

{
    "name":"hari",
    "email":"hari@gmail.com",
    "phone":"4567890",
    "salary":"70000",
    "department":"hr",
    "location":"thrissur"
}

#api call for deleting employee
###
DELETE http://127.0.0.1:8000/employees/1/